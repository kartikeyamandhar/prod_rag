# Copy to .env and fill in. No real secret ever enters the repo; .env is gitignored.

# Local Postgres (docker compose). Host port defaults to 5433 because a native
# Postgres owns 127.0.0.1:5432 on the dev laptop.
DATABASE_URL=postgresql://rag:rag_local_dev@127.0.0.1:5433/rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev
POSTGRES_DB=rag
POSTGRES_PORT=5433

# AWS / Bedrock. Used only in the approval-gated phases (7 and 8).
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Embeddings (fastembed ONNX, CPU), single model per CLAUDE.md
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# GitHub REST, read-only public scope, ticket corpus pull (Phase 1b)
GITHUB_TOKEN=
