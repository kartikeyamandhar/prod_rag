# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets: only .env.example is committed
.env

# Large corpus artifacts travel by rsync, not git (caption cache JSON IS committed)
artifacts/*.parquet
artifacts/*.jsonl

# Local clone cache of upstream corpora; reproduced by ingest/clone_docs.py
.corpus_cache/

# Terraform: state and live variables stay local; the lock file IS committed
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars

# macOS
.DS_Store

# Campaign log stays local, never committed
PHASES.md
CLAUDE.md

# Terraform plan artifacts must never be committed (leak resolved vars/state)
infra/tfplan
*.tfplan
artifacts/.run_ordinal
