{
 "uid": "rag-incidents",
 "title": "rag-incident-lab: serving + incidents",
 "schemaVersion": 39,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Tickets by route (rate/min)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "rag-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(rag_tickets_total[1m])) * 60",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Degraded share of tickets",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "rag-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(rag_tickets_total{degraded=\"true\"}[5m])) / sum(rate(rag_tickets_total[5m]))",
     "legendFormat": "degraded fraction"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Stage latency p95 (5m)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "rag-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(rag_stage_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Degrades by stage/reason + admission rejects (rate/min)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "rag-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (stage, reason) (rate(rag_degrade_total[1m])) * 60",
     "legendFormat": "{{stage}}: {{reason}}"
    },
    {
     "refId": "B",
     "expr": "rate(rag_admission_rejects_total[1m]) * 60",
     "legendFormat": "admission rejects"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Bedrock tokens (rate/min)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "rag-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (direction) (rate(rag_bedrock_tokens_total[1m])) * 60",
     "legendFormat": "{{direction}}"
    }
   ]
  }
 ]
}
